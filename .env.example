# Ratina.ai Environment Configuration
PORT=3001

# Monid pay-per-call gateway key (server-side only, never exposed to the client)
MONID_API_KEY=your_monid_live_api_key_here

# Signing key for verifiable analysis receipts (HMAC-SHA256).
# REQUIRED IN PRODUCTION: without it the server generates an ephemeral key at
# boot, so receipts issued before a restart will no longer verify afterwards.
# Generate one with:  openssl rand -hex 32
RATINA_RECEIPT_SECRET=replace_with_a_32_byte_hex_secret
